<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    app:startDestination="@id/settingsFragment">

    <fragment
        android:id="@+id/settingsFragment"
        android:name="com.cns.wekezamoney.ui.SettingsFragment"
        tools:layout="@layout/fragment_settings">
        <action
            android:id="@+id/action_settingsFragment_to_expenseFragment"
            app:destination="@id/expenseFragment" />
        <action
            android:id="@+id/action_settingsFragment_to_budgetFragment"
            app:destination="@id/budgetFragment" />
        <action
            android:id="@+id/action_settingsFragment_to_goalFragment"
            app:destination="@id/goalFragment" />
    </fragment>

    <fragment
        android:id="@+id/expenseFragment"
        android:name="com.cns.wekezamoney.ui.ExpenseFragment"
        tools:layout="@layout/fragment_expense" />

    <fragment
        android:id="@+id/budgetFragment"
        android:name="com.cns.wekezamoney.ui.BudgetFragment"
        tools:layout="@layout/fragment_budget" />

    <fragment
        android:id="@+id/goalFragment"
        android:name="com.cns.wekezamoney.ui.GoalFragment"
        tools:layout="@layout/fragment_goal" />
</navigation>
